# ============================================
# VoteGuide AI — Environment Variables
# ============================================
# Copy this file to .env and replace with your actual API keys.
# NEVER commit .env to version control.

# Google Gemini API Keys (get from https://aistudio.google.com/)
GEMINI_PRIMARY_KEY=your_gemini_primary_api_key_here
GEMINI_BACKUP_KEY=your_gemini_backup_api_key_here

# Mistral API Key (get from https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# Firebase Project
FIREBASE_PROJECT_ID=election-process-app
