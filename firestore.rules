rules_version = '2';

// VoteGuide AI — Firestore Security Rules
// Principle of least privilege: deny all by default, allow only what's needed.

service cloud.firestore {
  match /databases/{database}/documents {

    // Quiz Leaderboard — public read, authenticated write with validation
    match /quizScores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['score', 'displayName', 'userId', 'timestamp'])
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow update, delete: if false;
    }

    // User profiles — users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
